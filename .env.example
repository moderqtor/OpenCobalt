# OpenCobalt environment configuration
# Copy this file to .env and fill in values you want to use.
# .env is gitignored. Never commit real credentials.
# All settings below are optional. OpenCobalt works without any of them.

# --- Ollama ---
# OLLAMA_HOST=http://localhost:11434

# --- Optional API adapters (disabled by default) ---
# Only configure these if you want optional API routing.
# OpenCobalt is local-first and does not require any API key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Budget control (optional) ---
# OPENCOBALT_MONTHLY_BUDGET_USD=5.00
# OPENCOBALT_PER_RUN_MAX_USD=0.50

# --- Paths ---
# OPENCOBALT_DB_PATH=.opencobalt/ledger.db
# OPENCOBALT_EXPORT_PATH=.opencobalt/exports
